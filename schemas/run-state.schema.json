{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ioant.dev/verify/run-state.schema.json",
  "title": "Ioant Verify persisted run state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "logical_key",
    "project",
    "requested_commit",
    "tested_commit",
    "suite",
    "suite_version",
    "attempt",
    "mode",
    "lifecycle_state",
    "result",
    "started_at",
    "finished_at",
    "report_dir"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "logical_key": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "requested_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "tested_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "suite": {
      "type": "string",
      "minLength": 1
    },
    "suite_version": {
      "type": "integer",
      "minimum": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle_state": {
      "enum": [
        "DISCOVERED",
        "QUEUED",
        "PREPARING",
        "BUILDING",
        "STARTING_ENVIRONMENT",
        "RUNNING",
        "COLLECTING",
        "EVALUATING",
        "PASS",
        "FAIL",
        "BLOCKED",
        "INFRA_ERROR",
        "SKIPPED",
        "ARCHIVED"
      ]
    },
    "result": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "INFRA_ERROR",
        "SKIPPED",
        null
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "report_dir": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
