{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ioant.dev/verify/report.schema.json",
  "title": "Ioant Verify report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "project",
    "requested_commit",
    "tested_commit",
    "suite",
    "suite_version",
    "attempt",
    "mode",
    "started_at",
    "finished_at",
    "result",
    "environment",
    "cases",
    "artifacts",
    "device_required_followups"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "format": "uuid"},
    "project": {"type": "string", "minLength": 1},
    "requested_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tested_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "ledger_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "task_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "suite": {"type": "string", "minLength": 1},
    "suite_version": {"type": "integer", "minimum": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "mode": {
      "enum": ["none", "static", "simulator", "mac", "mac+simulator", "device-required", "manual-only"]
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "result": {"enum": ["pass", "fail", "blocked", "infra_error", "skipped"]},
    "environment": {"type": "object"},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "result",
          "expected",
          "observed",
          "duration_seconds",
          "evidence",
          "failure_reason"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "result": {"enum": ["pass", "fail", "blocked", "infra_error", "skipped"]},
          "expected": {},
          "observed": {},
          "duration_seconds": {"type": "number", "minimum": 0},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "failure_reason": {"type": ["string", "null"]}
        }
      }
    },
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "device_required_followups": {"type": "array", "items": {"type": "string"}}
  }
}
